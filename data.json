.ru/projects/dynasty", "imageSource": "https://static.tildacdn.com/tild3932-6234-4165-b134-626365326136/5__131_81.png"}], "documents": [{"name": "Выписка из ЕГРН", "url": "https://docs.yandex.ru/docs/view?url=ya-disk-public%3A%2F%2F0%2FUGwu3IUdwfZcyLkKIVlnQ%2BFwEEHFSBFxcIrLUDqY4zW1UWrdSx5IO1uYO8JdHhq%2FJ6bpmRyOJonT3VoXnDag%3D%3D%3A%2F%D0%94%D0%B8%D0%BD%D0%B0%D1%81%D1%82%D0%B8%D1%8F%20%2F%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%8B%2F%D0%B2%D1%8B%D0%BF%D0%B8%D1%81%D0%BA%D0%B0%20%D0%B8%D0%B7%20%D0%B5%D0%B3%D1%80%D0%BD.pdf&name=%D0%B2%D1%8B%D0%BF%D0%B8%D1%81%D0%BA%D0%B0%20%D0%B8%D0%B7%20%D0%B5%D0%B3%D1%80%D0%BD.pdf&nosw=1"}, {"name": "Разрешение на строительство", "url": "https://docs.yandex.ru/docs/view?url=ya-disk-public%3A%2F%2F0%2FUGwu3IUdwfZcyLkKIVlnQ%2BFwEEHFSBFxcIrLUDqY4zW1UWrdSx5IO1uYO8JdHhq%2FJ6bpmRyOJonT3VoXnDag%3D%3D%3A%2F%D0%94%D0%B8%D0%BD%D0%B0%D1%81%D1%82%D0%B8%D1%8F%20%2F%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%8B%2F%D0%A0%D0%B0%D0%B7%D1%80%D0%B5%D1%88%D0%B5%D0%BD%D0%B8%D0%B5_%D0%BD%D0%B0_%D1%81%D1%82%D1%80%D0%BE%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D1%81%D0%B2%D0%BE_%D0%98%D0%9C%D0%9F%D0%95%D0%A0%D0%98%D0%90%D0%9B.pdf&name=%D0%A0%D0%B0%D0%B7%D1%80%D0%B5%D1%88%D0%B5%D0%BD%D0%B8%D0%B5_%D0%BD%D0%B0_%D1%81%D1%82%D1%80%D0%BE%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D1%81%D0%B2%D0%BE_%D0%98%D0%9C%D0%9F%D0%95%D0%A0%D0%98%D0%90%D0%9B.pdf&nosw=1"}], "source": "https://elsamgroup.ru/projects/dynasty", "status": "Строится"}, {"id": "vesna", "name": "Весна", "city": "Каспийск", "address": "ул. Байрамова, 14Б", "year": "IV квартал 2027", "installment": "до 36 месяцев", "deposit": "от 1 млн ₽", "image": "/assets/vesna.webp", "gallery": ["/assets/vesna-gallery-0.webp", "/assets/vesna-gallery-1.webp", "/assets/vesna-gallery-2.webp", "/assets/vesna-gallery-3.webp", "/assets/vesna-gallery-4.webp", "/assets/vesna-gallery-5.webp", "/assets/vesna-gallery-6.webp", "/assets/vesna-gallery-7.webp"], "description": "«Весна» — это жилой комплекс класса «Комфорт+», расположенный в историческом центре Каспийска, где продуманность каждой квартиры сочетается с богатой городской инфраструктурой. Комплекс сочетает в себе благоустроенные зоны для отдыха, закрытую территорию и современные планировки, обеспечивающие функциональность и уют.\n\nБлизость более 500 объектов инфраструктуры обеспечивает жителям доступ ко всем необходимым сервисам в шаговой доступности, делая жизнь максимально удобной и независимой от транспорта. «Весна» — идеальный выбор для тех, кто ценит комфорт и удобство городской среды.", "advantages": "Локация\n\nОзеленение и двор\n\nАрхитектура\n\nПаркинг и территория\n\nВходная группа\n\nДизайнерские лобби\n\nКладовые\n\nИнженерные решения\n\nЖК «Весна» расположен в историческом центре города, в сформированном жилом районе с высокой концентрацией городской инфраструктуры. В пешей и короткой транспортной доступности — более 500 объектов: школы и детские сады, медицинские учреждения, магазины, кафе, спортивные и сервисные пространства. Это локация для тех, кто ценит жизнь в центре событий, удобство повседневных маршрутов и экономию времени.\n\nОзеленение и двор\n\nТерритория жилого комплекса спроектирована как уютное дворовое пространство для ежедневного отдыха. Во дворе предусмотрены зоны для детей, места для спокойного отдыха и прогулок. Озеленение формирует комфортную среду внутри плотной городской застройки, создавая ощущение уюта и защищённости.\n\nАрхитектура ЖК «Весна» выполнена в современном городском стиле, с акцентом на практичность и визуальную аккуратность. Фасады комплекса облицованы натуральным декоративным кирпичом, что придаёт дому выразительный и тёплый облик, а также обеспечивает долговечность и устойчивость к внешним воздействиям. Панорамное остекление наполняет квартиры естественным светом и формирует гармоничный архитектурный образ, соответствующий центральной части города.\n\nПаркинг и организация территории\n\nПридомовая территория организована с учётом комфорта жителей. Парковочные места расположены таким образом, чтобы не мешать дворовому пространству и повседневному отдыху. Это делает двор более спокойным и удобным для семей с детьми.\n\nВходная группа начинается с просторного дизайнерского лобби, которое формирует первое впечатление о доме. Пространство организовано удобно для повседневного использования: предусмотрены колясочные и зоны хранения, что особенно важно для семей с детьми и активного городского ритма жизни. Лобби спроектировано с учётом комфорта жителей и логики ежедневных маршрутов.\n\nМногоступенчатая система контроля: круглосуточное видеонаблюдение, контроль доступа по чип-картам и служба консьержей. Вы можете быть абсолютно уверены в неприкосновенности своего пространства и безопасности вашей семьи 24/7.\n\nДля удобства хранения предусмотрены кладовые помещения. Они позволяют рационально использовать пространство квартиры и хранить сезонные вещи, инвентарь и бытовые принадлежности.\n\nЖилой комплекс оснащён современными инженерными системами: надёжные лифты, эффективные системы отопления и вентиляции, современные коммуникации для стабильной связи и интернета — всё, что необходимо для комфортной городской жизни.", "plans": [{"id": "vesna-1", "projectId": "vesna", "project": "Весна", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "49,4", "image": "/assets/a81c2787e8e562eb17.webp", "thumb": "/assets/a81c2787e8e562-thumb.webp", "source": "https://elsamgroup.ru/projects/vesna", "imageSource": "https://static.tildacdn.com/tild3637-3135-4836-b261-386561626566/noroot.png"}, {"id": "vesna-2", "projectId": "vesna", "project": "Весна", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "49,8", "image": "/assets/af5e223958c929e68b.webp", "thumb": "/assets/af5e223958c929-thumb.webp", "source": "https://elsamgroup.ru/projects/vesna", "imageSource": "https://static.tildacdn.com/tild6430-3366-4131-b933-366666633733/noroot.png"}, {"id": "vesna-3", "projectId": "vesna", "project": "Весна", "city": "Каспийск", "type": "2", "name": "2-ком