BD%20%D0%92%D0%95%D0%A1%D0%9D%D0%90%20.pdf&name=%D0%92%D1%8B%D0%BF%D0%B8%D1%81%D0%BA%D0%B0%20%D0%B8%D0%B7%20%D0%B5%D0%B3%D1%80%D0%BD%20%D0%92%D0%95%D0%A1%D0%9D%D0%90%20.pdf&nosw=1"}, {"name": "Разрешение на строительство", "url": "https://docs.yandex.ru/docs/view?url=ya-disk-public%3A%2F%2F0%2FUGwu3IUdwfZcyLkKIVlnQ%2BFwEEHFSBFxcIrLUDqY4zW1UWrdSx5IO1uYO8JdHhq%2FJ6bpmRyOJonT3VoXnDag%3D%3D%3A%2F%D0%92%D0%B5%D1%81%D0%BD%D0%B0%2F%D0%B4%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%8B%2F%D0%A0%D0%B0%D0%B7%D1%80%D0%B5%D1%88%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%92%D0%B5%D1%81%D0%BD%D0%B0.pdf&name=%D0%A0%D0%B0%D0%B7%D1%80%D0%B5%D1%88%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%92%D0%B5%D1%81%D0%BD%D0%B0.pdf&nosw=1"}], "source": "https://elsamgroup.ru/projects/vesna", "status": "Строится"}, {"id": "moscow", "name": "Москва", "city": "Каспийск", "address": "ул. Амет-хана Султана, 26/3", "year": "IV квартал 2029", "installment": "до 60 месяцев", "deposit": "уточняется", "image": "/assets/moscow.webp", "gallery": ["/assets/moscow-gallery-0.webp", "/assets/moscow-gallery-1.webp", "/assets/moscow-gallery-2.webp", "/assets/moscow-gallery-3.webp", "/assets/moscow-gallery-4.webp", "/assets/moscow-gallery-5.webp", "/assets/moscow-gallery-6.webp", "/assets/moscow-gallery-7.webp"], "description": "Комплекс нового поколения в Каспийске. «Москва» — это проект, в котором архитектура индустриального прошлого обретает новое звучание в контексте прогрессивного городского ритма.\n\nКаменная кладка сочетается с металлом и стеклом, формируя мощный визуальный код — узнаваемый и актуальный одновременно.\n\nФасады облицованы цинковым композитом, что придаёт зданию технологичность и холодную сдержанность металла.", "advantages": "Локация\n\nЛандшафтный дизайн\n\nАрхитектура\n\nВходные группы\n\nПространство двора\n\nТорговая галерея\n\nПаркинг\n\nИнженерные решения\n\nЖилой комплекс расположен в активно развивающемся районе Каспийска — на пересечении улиц Ахметхана Султана и Кавказской. Благодаря новой транспортной развязке обеспечен удобный выезд на ключевые магистрали города.\n\nВ шаговой доступности: прогулочная аллея, магазины, кафе и сервисы повседневной инфраструктуры\n\nОбразовательные учреждения рядом с комплексом: школа, два детских сада\n\nТихий, огороженный внутренний двор с прогулочными тропинками, зелёными зонами и лаундж-пространствами для отдыха жителей.\n\nАрхитектура и фасад\n\nДекоративное освещение фасада. Современные решения по подсветке подчёркивают архитектурную эстетику комплекса и формируют выразительный облик в тёмное время суток. Освещение интегрировано в дизайн здания, обеспечивая гармоничное сочетание стиля и функциональности.\n\nДизайнерское оформление. Элегантное фойе с высокими потолками и панорамными окнами создаёт атмосферу уюта и комфорта. В отделке используются премиальные материалы, сочетающие стиль и долговечность. Предусмотрена просторная колясочная зона для удобства семей с детьми.\n\nВнутренний двор спроектирован с учётом рекомендаций детских психологов. Здесь предусмотрены: игровые и развивающие зоны, спортивные площадки для детей и взрослых, озеленённые участки и продуманные места для отдыха. Двор закрыт от машин, логично зонирован и отвечает требованиям безопасности, комфорта и эстетики.\n\nНа территории комплекса предусмотрены современные детские пространства с безопасными покрытиями, игровыми модулями и развивающим оборудованием. Среда создана так, чтобы дети могли активно двигаться, играть, исследовать и учиться в уютном дворе.\n\nНа территории комплекса предусмотрена современная торговая галерея, где разместятся: магазины, кофейни, аптеки, сервисы повседневного спроса. Все необходимые услуги — не покидая пределы жилого комплекса.\n\nПодземный и наземный. Подземный паркинг на 300 машиномест — в распоряжении резидентов ЖК «Москва». Автоматическое распознавание номеров, безопасный и комфортный въезд, прямой доступ из подъездов на лифтах\n\nТри бесшумных скоростных лифта, система резервного питания, бесперебойная работа лифтов даже при отключении электричества", "plans": [{"id": "moscow-1", "projectId": "moscow", "project": "Москва", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "23,16", "image": "/assets/7c74b41f7868c6d225.webp", "thumb": "/assets/7c74b41f7868c6-thumb.webp", "source": "https://elsamgroup.ru/projects/moscow", "imageSource": "https://static.tildacdn.com/tild3935-3836-4637-a633-393336653135/1_23-16.png"}, {"id": "moscow-2", "projectId": "moscow", "project": "Москва", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "24,08", "image": "/assets/67ad9f2832efbfb5fe.webp", "thumb": "/assets/67ad9f2832efbf-thumb.webp", "source": "https://elsamgroup.ru/projects/moscow", "imageSource": "https://static.tildacdn.com/tild6665-3763-4539-b337-376266333464/1_24-08.png"}, {"id": "moscow-3", "projectId": "moscow", "project": "Москва", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "24,69", "image": "/assets/d53d65f2d8dabf15a9.webp", "thumb": "/assets/d53d65f2d8dabf-thumb.webp", "source": "https://elsamgroup.ru/projects/moscow", "imageSource": "https://static.tildacdn.com/tild6639-6435-4331-b737-646433353630/1_24-69.png"}, {"id": "moscow-4", "projectId": "moscow", "project": "Москва", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "47,13", "image": "/assets/911564648af732a345.webp", "thumb": "/assets/911564648af732-thumb.webp", "source": "https://elsamgroup.ru/projects/moscow", "imageSource": "https://static.tildacdn.com/tild3634-3334-4632-b730-336565376635/1_47-13-1.png"}, {"id": "moscow-5", "projectId": "moscow", "project": "Москва", "city": "Каспийск", "type": "1", "name": "1-комнатная", "area": "47,13", "image": "/assets/d8e3a108b670e27ba7.webp", "thumb": "/assets/d8e3a108b670e2-thumb.webp", "source": "https://elsamgroup.ru/projects/moscow", "imageSource": "https://static.tildacdn.com/tild3965-3632-4438-b737-373931323830/1_47-13.png"}, {"id": "moscow-6", "projectId": "moscow", "project": "Москва", "city": "Каспийск", "type": "1", "na